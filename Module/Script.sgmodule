#!name=网络优化与增强
#!desc=APNs 推送、代理兼容、QUIC 控制与防跳转
#!category=xinian

[General]
# > 代理检测
skip-proxy = %APPEND% www.baidu.com,yunbusiness.ccb.com,wxh.wo.cn,gate.lagou.com,www.abchina.com.cn,www.shanbay.com,login-service.mobile-bank.psbc.com,mobile-bank.psbc.com,id6.me,iosapps.itunes.apple.com,*.byd.auto
# > DNS返回假IP
always-real-ip = %APPEND% easy-login.10099.com.cn,*-update.xoyocdn.com,id6.me,open.e.189.cn

[Rule]
# 苹果 APNs 推送：更新后开关飞行模式；无效则在「更多设置→高级设置」开启「包含所有网络」和「包含APNS」选项
DOMAIN-SUFFIX,push.apple.com,𝗣𝗥𝗢𝗫𝗬
DOMAIN-SUFFIX,akadns.net,𝗣𝗥𝗢𝗫𝗬
DOMAIN-KEYWORD,apple.com.edgekey.net,𝗣𝗥𝗢𝗫𝗬
IP-CIDR,17.249.0.0/16,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR,17.252.0.0/16,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR,17.57.144.0/22,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR,17.188.128.0/18,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR,17.188.20.0/23,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR6,2620:149:a44::/48,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR6,2403:300:a42::/48,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR6,2403:300:a51::/48,𝗣𝗥𝗢𝗫𝗬,no-resolve
IP-CIDR6,2a01:b740:a42::/48,𝗣𝗥𝗢𝗫𝗬,no-resolve
# > 阻止所有UDP流量到端口443，使HTTP3请求退回到TCP流量
AND,((PROTOCOL,UDP), (DEST-PORT,443)),REJECT-NO-DROP
# 防止TG加载转圈
IP-CIDR,95.161.76.100/31,𝗥𝗘𝗝𝗘𝗖𝗧,no-resolve,pre-matching
# > Safari 防跳转
DOMAIN,app-site-association.cdn-apple.com,𝗥𝗘𝗝𝗘𝗖𝗧,pre-matching
# 巨量千川
DOMAIN-SUFFIX,zijieapi.com,𝗗𝗜𝗥𝗘𝗖𝗧
# TIKTOK
DOMAIN-SUFFIX,ads.tiktok.com,𝗣𝗥𝗢𝗫𝗬
# 淘宝联盟
DOMAIN-SUFFIX,alimama.com,𝗗𝗜𝗥𝗘𝗖𝗧
# 1688
DOMAIN,dj.1688.com,𝗗𝗜𝗥𝗘𝗖𝗧
# 百度智能云
DOMAIN-SUFFIX,bce.baidu.com,𝗗𝗜𝗥𝗘𝗖𝗧
# 抖音巨量引擎
DOMAIN-SUFFIX,oceanengine.com,𝗗𝗜𝗥𝗘𝗖𝗧
DOMAIN-SUFFIX,byteadverts.com,𝗗𝗜𝗥𝗘𝗖𝗧
# Apple Intelligence + ChatGPT 专用
DOMAIN,gspe1-ssl.ls.apple.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,apple-relay.apple.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,apple-relay.cloudflare.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,apple-relay.fastly-edge.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,apple-relay.akamaized.net,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,apple-relay.mask.apple-dns.net,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,cp4.cloudflare.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,mask-api.icloud.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,mask.icloud.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
DOMAIN,mask-h2.icloud.com,"𝗨𝗻𝗶𝘁𝗲𝗱 𝗦𝘁𝗮𝘁𝗲𝘀"
# 普通 Siri 直连
DOMAIN,guzzoni.apple.com,𝗗𝗜𝗥𝗘𝗖𝗧
DOMAIN,dejavu.apple.com,𝗗𝗜𝗥𝗘𝗖𝗧
DOMAIN-SUFFIX,siri.apple.com,𝗗𝗜𝗥𝗘𝗖𝗧
DOMAIN-SUFFIX,smoot.apple.com,𝗗𝗜𝗥𝗘𝗖𝗧
# Adobe软件屏蔽
PROCESS-NAME,"/Applications/Adobe Photoshop 2026/Adobe Photoshop 2026.app/",𝗥𝗘𝗝𝗘𝗖𝗧
PROCESS-NAME,"/Applications/Adobe Illustrator 2026/Adobe Illustrator.app/",𝗥𝗘𝗝𝗘𝗖𝗧
