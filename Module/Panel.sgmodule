#!name=策略面板
#!desc=流媒体解锁检测+今日油价信息展示
#!category=xinian

[Panel]
策略面板 = script-name=解锁检测,update-interval=86400
策略面板 = script-name=今日油价,update-interval=86400

[Script]
解锁检测 = type=generic,timeout=30,engine=webview,script-path=https://raw.githubusercontent.com/Former-Years/Surge/main/Script/Stream-All.js,argument=title=解锁检测&icon=eye.slash.circle.fill&color=#ffb621
今日油价 = type=generic,timeout=30,engine=webview,script-path=https://raw.githubusercontent.com/Former-Years/Surge/refs/heads/main/Script/Oil.js,argument=title=今日油价&icon=fuelpump.circle.fill&color=#3b5fb0&provname=广东
